<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário para publicar ou editar um objeto -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activity.FormularioObjetoActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar"
        app:title="@string/formulario_titulo_novo" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Perdido ou achado -->
            <TextView
                style="@style/EtiquetaCampo"
                android:text="@string/campo_tipo" />

            <RadioGroup
                android:id="@+id/grupo_tipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_perdido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/tipo_perdi" />

                <RadioButton
                    android:id="@+id/radio_achado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tipo_achei" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/campo_titulo"
                app:counterEnabled="true"
                app:counterMaxLength="60">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="60" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/campo_descricao"
                app:counterEnabled="true"
                app:counterMaxLength="500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_descricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/EtiquetaCampo"
                android:text="@string/campo_categoria" />

            <Spinner
                android:id="@+id/spinner_categoria"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="@string/campo_data" />

            <Button
                android:id="@+id/botao_data"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="13/11/2026" />

            <!-- Fotografia (câmara ou galeria) -->
            <TextView
                style="@style/EtiquetaCampo"
                android:text="@string/campo_foto" />

            <ImageView
                android:id="@+id/imagem_foto"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/fundo_foto"
                android:contentDescription="@string/descricao_foto"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_sem_foto" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botao_camara"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/tirar_foto"
                    app:icon="@drawable/ic_camara" />

                <Button
                    android:id="@+id/botao_galeria"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/escolher_galeria" />
            </LinearLayout>

            <!-- Local: descrição escrita + posição GPS -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_local"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/campo_local"
                app:counterEnabled="true"
                app:counterMaxLength="100"
                app:helperText="@string/ajuda_local">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/texto_gps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                tools:text="@string/gps_sem_posicao" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botao_gps"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/usar_localizacao"
                    app:icon="@drawable/ic_local" />

                <Button
                    android:id="@+id/botao_remover_gps"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remover" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progresso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/botao_guardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/guardar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
