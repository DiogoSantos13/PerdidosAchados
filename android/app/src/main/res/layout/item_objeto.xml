<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de um objeto, injetado na RecyclerView -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_imagem"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@color/fundo_foto"
            android:contentDescription="@string/descricao_foto"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_sem_foto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_tipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Perdido"
                    tools:textColor="@color/perdido" />

                <TextView
                    android:id="@+id/item_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/estado_resolvido"
                    android:textAllCaps="true"
                    android:textColor="@color/resolvido"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/item_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Carteira castanha em pele" />

            <TextView
                android:id="@+id/item_local"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp"
                tools:text="Cantina" />

            <TextView
                android:id="@+id/item_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                tools:text="13/11/2026 · a 120 m" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
